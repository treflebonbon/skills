  "method": "既存の bin/codex-reviewer を、実モデルを呼ばない C observer を codex として起動して採取。FD と signal mask は observer seed が設定する。raw の namespace と Nix 起動はこの corpus で実行していない。",
  "cases": [
    {
      "name": "inheritable-fd-and-mask",
      "command": [
        "<observer>",
        "seed",
        "<file>",
        "inherit",
        "blocked",
        "bin/codex-reviewer",
        "--",
        "report",
        "37",
        "literal ; $() 🙂",
        ""
      ],
      "expected": {
        "exitCode": 37,
        "signal": null,
        "samePid": true,
        "sameParent": true,
        "sameGroup": true,
        "sameSession": true,
        "usr1Blocked": 1,
        "fdInherited": true,
        "fdCloexec": 0,
        "tty": [0, 0, 0],
        "marker": "literal🙂",
        "literalTail": ["--", "report", "37", "literal ; $() 🙂", ""]
      }
    },
    {
      "name": "cloexec-fd",
      "command": [
        "<observer>",
        "seed",
        "<file>",
        "cloexec",
        "clear",
        "bin/codex-reviewer",
        "--",
        "report",
        "37",
        "literal ; $() 🙂",
        ""
      ],
      "expected": {
        "exitCode": 37,
        "signal": null,
        "samePid": true,
        "sameParent": true,
        "sameGroup": true,
        "sameSession": true,
        "usr1Blocked": 0,
        "fdInherited": false,
        "fdCloexec": null,
        "tty": [0, 0, 0],
        "marker": "literal🙂",
        "literalTail": ["--", "report", "37", "literal ; $() 🙂", ""]
      }
    }
  ]
}
