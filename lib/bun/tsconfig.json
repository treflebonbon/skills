{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "typeRoots": ["../../development/node_modules/@types"],
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../../skills/product-guide/scripts/*.ts",
    "../../tests/bun/**/*.ts",
    "../../tests/helpers/*.ts",
    "../../skills/dogfood/tests/helpers/*.ts",
    "../../development/*.ts",
    "../../skills/*-peer-refactor/scripts/*.ts"
  ]
}
