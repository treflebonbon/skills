#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "usage: git-push-topic" >&2
  exit 2
fi

git_command="$(type -P git || true)"
if [ -z "$git_command" ]; then
  echo "ERROR: Git is required" >&2
  exit 1
fi
case "$git_command" in
/*) ;;
*) git_command="$PWD/$git_command" ;;
esac

branch="$("$git_command" branch --show-current)"
if [ -z "$branch" ]; then
  echo "ERROR: detached HEAD cannot be published as a topic branch" >&2
  exit 1
fi

command_name="$(basename "$0")"
if [ "$command_name" != "git-push-reviewed" ]; then
  case "$branch" in
  main | master)
    echo "ERROR: refusing to push default branch: $branch" >&2
    exit 1
    ;;
  esac
fi

if ! remote_head="$("$git_command" ls-remote --symref origin HEAD 2>/dev/null)"; then
  echo "ERROR: cannot resolve origin's default branch" >&2
  exit 1
fi
default_ref=""
while IFS=$' \t' read -r key value ref; do
  if [ "$key" = "ref:" ] && [ "$ref" = "HEAD" ]; then
    default_ref="$value"
    break
  fi
done <<<"$remote_head"
case "$default_ref" in
refs/heads/*) ;;
*)
  echo "ERROR: cannot resolve origin's default branch" >&2
  exit 1
  ;;
esac
default_branch="${default_ref#refs/heads/}"

if [ "$command_name" = "git-push-reviewed" ]; then
  if [ "$branch" != "$default_branch" ]; then
    echo "ERROR: refusing reviewed push from non-default branch: $branch" >&2
    exit 1
  fi
else
  if [ "$branch" = "$default_branch" ]; then
    echo "ERROR: refusing to push default branch: $branch" >&2
    exit 1
  fi

  # A commit that failed in a hook leaves HEAD equal to the default branch; refuse to publish it.
  # The local origin/<default> can be stale or missing, so compare against the tip ls-remote reported.
  default_sha=""
  while IFS=$' \t' read -r key value _; do
    if [ "$key" != "ref:" ] && [ "$value" = "HEAD" ]; then
      default_sha="$key"
      break
    fi
  done <<<"$remote_head"
  # is_ancestor <commit> <descendant>: succeeds when <commit> is in <descendant>'s history. A commit this
  # clone does not have cannot be in it. Any other failure is not an answer, so stop instead of guessing.
  is_ancestor() {
    local status=0
    "$git_command" cat-file -e "$1^{commit}" 2>/dev/null || return 1
    "$git_command" merge-base --is-ancestor "$1" "$2" || status=$?
    case "$status" in
    0 | 1) return "$status" ;;
    esac
    echo "ERROR: cannot compare $1 with $2" >&2
    exit 1
  }

  # The tip is fetched so its history is available to is_ancestor. A shallow history can report
  # "not an ancestor" for a commit that is one, so it cannot be trusted.
  if [ -z "$default_sha" ] || [ "$("$git_command" rev-parse --is-shallow-repository)" != false ] ||
    ! "$git_command" fetch -q origin "$default_ref"; then
    echo "ERROR: cannot compare HEAD with origin/$default_branch" >&2
    exit 1
  fi
  if is_ancestor HEAD "$default_sha"; then
    echo "ERROR: $branch has no commits beyond origin/$default_branch; check that the last commit succeeded" >&2
    exit 1
  fi

  # Once a PR from this branch is merged, new commits on it never reach the default branch.
  # Reject a HEAD that contains the merged PR's head but not its merge result: that is a continuation
  # of the old branch. A same-named branch cut from the default branch afterwards contains the merge
  # result (a squash or rebase merge result is new, a merge commit keeps the old head reachable).
  cannot_check_merged_prs() {
    echo "ERROR: cannot check merged PRs for $branch" >&2
    exit 1
  }
  gh_command="$(type -P gh || true)"
  [ -n "$gh_command" ] || cannot_check_merged_prs
  case "$gh_command" in
  /*) ;;
  *) gh_command="$PWD/$gh_command" ;;
  esac
  # Name origin's repository explicitly so GH_REPO or a fork's upstream default cannot redirect the query.
  origin_url="$("$git_command" remote get-url origin)" || cannot_check_merged_prs
  merged_prs="$("$gh_command" pr list --repo "$origin_url" --head "$branch" --state merged --limit 1000 --json headRefOid,mergeCommit --jq '.[] | "\(.headRefOid) \(.mergeCommit.oid // "")"')" || cannot_check_merged_prs
  # A full page may have dropped older PRs.
  [ "$(printf '%s\n' "$merged_prs" | wc -l)" -lt 1000 ] || cannot_check_merged_prs
  while read -r merged_head merge_commit; do
    [ -n "$merged_head" ] || continue
    if [ -n "$merge_commit" ] && is_ancestor "$merge_commit" HEAD; then
      continue
    fi
    if is_ancestor "$merged_head" HEAD; then
      echo "ERROR: a PR from $branch is already merged; new commits would not reach $default_branch." >&2
      echo "Create a new branch from origin/$default_branch and cherry-pick them." >&2
      exit 1
    fi
  done <<<"$merged_prs"
fi

exec "$git_command" push -u origin HEAD
