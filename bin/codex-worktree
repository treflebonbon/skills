#!/bin/bash -p
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
source_dir="${source_path%/*}"
[[ "$source_dir" != "$source_path" ]] || source_dir=.
source_dir="$(cd -- "${source_dir:-/}" && pwd -P)"
helper="$source_dir/devshell-env"
if [[ ! -f "$helper" ]]; then
  printf 'codex-worktree: missing sibling helper: %s\n' "$helper" >&2
  exit 127
fi
exec "$helper" codex "$@"
