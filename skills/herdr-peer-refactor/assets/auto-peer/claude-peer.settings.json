{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Bash(treflebonbon-auto-policy-probe)",
      "Bash(*gh pr merge*)",
      "Bash(*gh pr 'merge'*)",
      "Bash(*gh pr \"merge\"*)",
      "Bash(*gh -R * pr merge*)",
      "Bash(*gh --repo * pr merge*)",
      "Bash(*gh --repo=* pr merge*)",
      "Bash(*gh pr -R * merge*)",
      "Bash(*gh pr --repo * merge*)",
      "Bash(*gh pr --repo=* merge*)",
      "Bash(*mergePullRequest*)",
      "Bash(*enablePullRequestAutoMerge*)",
      "Bash(*pulls/*/merge*)",
      "Bash(*gh api*/merges*)",
      "Bash(*git push*)",
      "Bash(*git * push*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": []
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.codex-peer",
          "mode": "deny"
        },
        {
          "path": "~/.claude-peer",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CODEX_ACCESS_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CODEX_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        }
      ]
    }
  }
}
